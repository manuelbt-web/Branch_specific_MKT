# Per-gene intermediate files (regenerate from run_report.R + the pipeline
# scripts in MKT_3_species/EnrichAlignment/). Only final per-species result
# tables are tracked, to keep this example lightweight.
speltoides/01_filtered/
speltoides/02_split/
speltoides/04_divergence/codeml_inputs/
speltoides/04_divergence/dnds_input/
speltoides/04_divergence/dnds_output/
speltoides/04_divergence/dnds_results/
